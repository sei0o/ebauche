<div class="view-mode">
  <% { "original" => "オリジナル", "gray" => "白黒", "value3" => "3段階", "value2" => "二値化" }.each do |mode, label| %>
    <button type="button" data-action="view-mode#select" data-mode="<%= mode %>" data-view-mode-target="button"><%= label %></button>
  <% end %>
  <label data-view-mode-target="threshold">
    しきい値
    <input type="range" min="-0.3" max="0.3" step="0.01" value="0" data-action="input->view-mode#shift" data-view-mode-target="slider">
  </label>
  <% if local_assigns[:slic] %>
    <label><input type="checkbox" data-slic-target="toggle" data-action="slic#toggle"> SLIC</label>
    <label>
      分割数
      <input type="range" min="5" max="100" step="5" data-slic-target="count" data-action="input->slic#preview change->slic#setCount">
      <output data-slic-target="output"></output>
    </label>
  <% end %>
</div>
